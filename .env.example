PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash-001

FAST_BACKFILL_MODE=true
FAST_BACKFILL_DAYS=5
FAST_TARGET_RECORDS=200000
MAX_WORKERS=16
CYCLE_SLEEP_MIN=60
CYCLE_SLEEP_MAX=300
INCREMENTAL_INTERVAL_HOURS=4
FAST_ENRICH_EVERY_N_CYCLES=1
DAILY_BUDGET_INR=500
DB_PATH=runtime.db
PUBLIC_DB_PATH=public.db
WATCH_INTERVAL_SECONDS=30

PLAY_COUNTRIES=us
APPLE_COUNTRIES=us,gb,ca,au,in,de,fr,jp
PLAY_PAGES_FAST=1
PLAY_COUNT_PER_PAGE=100
REDDIT_LIMIT_FAST=250
REDDIT_LIMIT_INCREMENTAL=100
REDDIT_HTTP_ENABLED=true
HACKERNEWS_ENABLED=true
PRODUCTHUNT_ENABLED=true
HACKERNEWS_LIMIT_FAST=40
HACKERNEWS_LIMIT_INCREMENTAL=20
PRODUCTHUNT_LIMIT_FAST=40
PRODUCTHUNT_LIMIT_INCREMENTAL=20
G2_ENABLED=true
CAPTERRA_ENABLED=true
UPWORK_LIMIT_FAST=75
UPWORK_LIMIT_INCREMENTAL=30
UPWORK_API_ENABLED=false
UPWORK_API_URL=https://www.upwork.com/api/graphql/v1
UPWORK_API_TOKEN=
UPWORK_API_MODE=graphql
UPWORK_API_TIMEOUT_SECONDS=30
UPWORK_API_MAX_RPS=8
UPWORK_API_MAX_RPM=240
UPWORK_API_MAX_DAILY=35000
# Safety clamp in code: max 10 rps, 300 rpm, 40000/day.
UPWORK_API_CACHE_TTL_SECONDS=3600
# Safety clamp in code: max 86400 seconds (24h).
UPWORK_API_FIRST_PARTY_REQUIRED=false
# Optional override: custom GraphQL query (must accept $query and $limit variables).
UPWORK_API_GRAPHQL_QUERY=
META_SEED_MIN_ROWS=120
META_USE_JINA_FALLBACK=true
META_RELAXED_MARKETPLACE_SIGNALS=false
JINA_PREFIX=https://r.jina.ai/http://
FAST_APPS_PER_CYCLE=160
FAST_APPLE_PER_CYCLE=140
FAST_REDDIT_PER_CYCLE=250
FAST_HACKERNEWS_PER_CYCLE=80
FAST_PRODUCTHUNT_PER_CYCLE=80
FAST_G2_PER_CYCLE=200
FAST_CAPTERRA_PER_CYCLE=200
FAST_UPWORK_PER_CYCLE=200
INC_APPS_PER_CYCLE=60
INC_APPLE_PER_CYCLE=50
INC_REDDIT_PER_CYCLE=100
INC_HACKERNEWS_PER_CYCLE=30
INC_PRODUCTHUNT_PER_CYCLE=30
INC_G2_PER_CYCLE=60
INC_CAPTERRA_PER_CYCLE=60
INC_UPWORK_PER_CYCLE=60
APPSTORE_FOCUS_ENABLED=true
APPSTORE_FOCUS_SKIP_PLAY_FOR_APPLE=true
PLAY_HELPERS=10
APPLE_HELPERS=10
REDDIT_HELPERS=6
HACKERNEWS_HELPERS=6
PRODUCTHUNT_HELPERS=6
META_HELPERS=12
UPWORK_HELPERS=8
UPWORK_QUERY_SIGNAL_FALLBACK=true
# Optional: set dataset endpoint for Upwork jobs (must return JSON list/items).
# Supports {query} placeholder.
UPWORK_DATASET_URL=

ENRICH_BATCH_SIZE=300
ENRICH_MAX_BATCHES_PER_RUN=10
FAST_PROCESS_SLEEP_SECONDS=1200
MIN_EVIDENCE_LINKS=2
MIN_EVIDENCE_MATCH_SCORE=0.22
MIN_AVG_EVIDENCE_MATCH_SCORE=0.18
MIN_SOURCES_FOR_PUBLISH=1
MIN_CANDIDATE_CONFIDENCE=0.65
REJECT_GENERIC_PAIN=true
ENABLE_TOP_REGEN=true
TOP_REGEN_LIMIT=20
AI_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_TEMPERATURE=0.2
AI_ENRICHMENT_MAX_ROWS=14
AI_ENRICHMENT_MAX_OUTPUT_TOKENS=1200
MAX_SUPPORTING_QUOTES=6
MIN_SUPPORTING_EVIDENCE_FOR_PUBLISH=2
CANDIDATE_VARIANTS_PER_CLUSTER=1
VARIANT_MIN_EVIDENCE=4
ENRICH_ALLOW_REPROCESS=false
ENRICH_REPROCESS_COOLDOWN_HOURS=24

# Optional (recommended for stable Reddit API usage)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=startupideadb-scraper/2.0

# Optional: direct Gemini API key fallback (if PROJECT_ID auth is unavailable).
GEMINI_API_KEY=

# Optional cost tuning
USD_TO_INR=83
FLASH_INPUT_USD_PER_MTOK=0.35
FLASH_OUTPUT_USD_PER_MTOK=1.05

